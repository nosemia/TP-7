#include <iostream>
using namespace std;

class Operaciones {
private:
    int num1, num2;

public:
    Operaciones(int, int);
    void operaciones();
};

Operaciones::Operaciones(int n1, int n2) {
    num1 = n1;
    num2 = n2;
}

void Operaciones::operaciones() {
    cout << "Suma: " << num1 + num2 << endl;
    cout << "Resta: " << num1 - num2 << endl;
    cout << "Multiplicacion: " << num1 * num2 << endl;
    cout << "Division: " << num1 / num2 << endl;
}

int main() {
    Operaciones op(10, 5);
    op.operaciones();

    return 0;
}
