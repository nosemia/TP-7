#include <iostream>
using namespace std;

class Sumatoria {
private:
    int suma;

public:
    Sumatoria();
    ~Sumatoria();
};

Sumatoria::Sumatoria() {
    int num;
    suma = 0;

    cout << "Ingrese un numero (0 para terminar): ";
    cin >> num;

    while (num != 0) {
        suma = suma + num;
        cin >> num;
    }
}

Sumatoria::~Sumatoria() {
    cout << "La suma es: " << suma;
}

int main() {
    Sumatoria s;

    return 0;
}
